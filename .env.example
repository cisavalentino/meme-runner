# Copy to .env (never commit; .env is gitignored). `rr` loads it without overriding real env vars.
# Optional: only needed for `--source dune` (needs a Dune plan that can run queries).
DUNE_API_KEY=
# Optional: CoinGecko demo key; used only with RR_GECKO_USE_KEY=1 (10k calls/month cap).
GECKOTERMINAL_API_KEY=
RR_GECKO_USE_KEY=0
# Optional: a private RPC (Helius etc.) is much faster than the public endpoint.
RR_SOLANA_RPC=
RR_DB_PATH=data/runner.sqlite
